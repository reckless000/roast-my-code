# Copy this file to .env and fill in your values. NEVER commit .env.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
PORT=3000

# Optional: Cloudflare Turnstile human check for public deployments.
# Get free keys at https://dash.cloudflare.com -> Turnstile. When both are set,
# /roast requires a valid Turnstile token (blocks bots from burning Groq tokens).
# Leave empty to disable the check (local dev).
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
