{
  "installCommand": "npm install --include=dev",
  "buildCommand": "npm run build",
  "functions": {
    "api/index.js": {
      "maxDuration": 60,
      "runtime": "nodejs20.x"
    }
  },
  "routes": [
    { "src": "^/api/.*", "dest": "/api/index" },
    { "src": "^/roast", "dest": "/api/index" },
    { "src": "^/config", "dest": "/api/index" },
    { "src": "^/health", "dest": "/api/index" },
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
